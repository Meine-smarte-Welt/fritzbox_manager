{
  "config": {
    "step": {
      "user": {
        "title": "FRITZ!Box verbinden",
        "description": "Trage die Adresse und die Zugangsdaten deiner FRITZ!Box ein. Die FRITZ!Box braucht einen Benutzer mit dem Recht „FRITZ!Box Einstellungen“, damit Schalten möglich ist. Lässt du den Port leer, wird der Standard verwendet.",
        "data": {
          "host": "Adresse (IP oder fritz.box)",
          "port": "Port (optional)",
          "username": "Benutzername",
          "password": "Kennwort",
          "ssl": "Verschlüsselte Verbindung (HTTPS)"
        }
      },
      "reauth_confirm": {
        "title": "Anmeldung erneuern",
        "description": "Die FRITZ!Box unter {host} hat die Anmeldung abgelehnt. Gib die aktuellen Zugangsdaten ein.",
        "data": {
          "username": "Benutzername",
          "password": "Kennwort"
        }
      },
      "reconfigure": {
        "title": "Verbindung neu konfigurieren",
        "data": {
          "host": "Adresse (IP oder fritz.box)",
          "port": "Port (optional)",
          "username": "Benutzername",
          "password": "Kennwort",
          "ssl": "Verschlüsselte Verbindung (HTTPS)"
        }
      }
    },
    "error": {
      "cannot_connect": "Die FRITZ!Box ist nicht erreichbar. Prüfe Adresse, Port und ob TR-064 aktiv ist (Heimnetz > Netzwerk > Netzwerkeinstellungen > Zugriff für Anwendungen zulassen).",
